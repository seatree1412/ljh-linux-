CC = gcc
AR = ar
CFLAGS = -Wall -Wextra -Iinclude
LIBDIR = lib
LIB = $(LIBDIR)/libcal.a
OBJECTS = $(LIBDIR)/add.o $(LIBDIR)/sub.o
TARGET = main-v1

all: $(TARGET)

$(LIBDIR)/%.o: src/%.c include/%.h
	$(CC) $(CFLAGS) -c $< -o $@

$(LIB): $(OBJECTS)
	$(AR) rcs $@ $^

$(TARGET): main.c $(LIB) include/add.h include/sub.h
	$(CC) $(CFLAGS) $< $(LIB) -o $@

clean:
	rm -f $(OBJECTS) $(LIB) $(TARGET) main
